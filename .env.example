# Public Supabase project configuration
NEXT_PUBLIC_SITE_URL=https://www.kabpharma.com
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
CUSTOMER_SESSION_SECRET=replace-with-at-least-32-random-characters
STAFF_SESSION_SECRET=use-a-different-random-secret-of-at-least-32-characters
OPENAI_API_KEY=your-openai-api-key
# Comma-separated bootstrap allowlist. Prefer the Supabase
# app_metadata role "admin" after initial setup.
ADMIN_EMAILS=owner@example.com

# NABDA WhatsApp OTP provider
NABDA_API_URL=https://your-nabda-provider.example
NABDA_API_KEY=your-nabda-api-key
NABDA_INSTANCE_ID=your-nabda-instance-id
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_CLARITY_PROJECT_ID=
NEXT_PUBLIC_ENABLE_PRESENCE=true

# Verification and password-reset emails (resend.com)
RESEND_API_KEY=

# Sham Cash payment verification
SHAMCASH_ACCOUNT_ID=
SHAMCASH_API_TOKEN=

# Order archive (second Supabase project) and its scheduled job
ARCHIVE_SUPABASE_URL=
ARCHIVE_SUPABASE_SERVICE_ROLE_KEY=
ARCHIVE_CRON_SECRET=

# Optional: a different AI model for the assistant
OPENAI_ASSISTANT_MODEL=
